# ── KAVACH AI Environment Configuration ──

# Application
APP_NAME=KAVACH AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./kavach.db

# JWT Authentication
JWT_SECRET_KEY=kavach-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# AI Models
AI_MODEL_DIR=./data/models
SCAM_PATTERNS_DIR=./data/scam_patterns

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=./logs/kavach.log
